Options -Indexes

RewriteEngine On
RewriteBase /netmon_v4/

RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/auth/token/?$ api/locations.php [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/locations/?$ api/locations.php [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/locations/([0-9]+)/?$ api/locations.php [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/locations/([0-9]+)/check/?$ api/locations.php [QSA,L]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
